function __aos_tty_store_history()
{
    tty_h[tty_head] = tty_payload;
    tty_head = (tty_head + 1) & 63;
    if(tty_count < HISTORY_RECORDS) { tty_count += 1; }
}

resident function __aos_tty_load_history_slot()
{
    tty_payload = tty_h[tty_slot];
}

function __aos_tty_emit()
{
    tty_payload = tty_line; __aos_tty_store_history();
}

function __aos_tty_emit_raw()
{
    __aos_raw_pin_history(); tty_payload = raw_obj + 223; __aos_tty_store_history();
}

function __aos_tty_clear_history()
{
    for(var i = 0; i < HISTORY_RECORDS; i += 1)
    {
        tty_h[i] = 0;
    }
    for(var j = 1; j <= RAW_OBJECT_COUNT; j += 1)
    {
        raw_hist[j] = false;
        if(!raw_file[j]) { raw_used[j] = false; }
    }
    tty_head = 0;
    tty_count = 0;
}

