resident function __aos_tty_redraw_now()
{
    if(tty_count > 24) { tty_remaining = 24; } else { tty_remaining = tty_count; }
    tty_slot = (tty_head - tty_remaining) & 63;
    while(tty_remaining > 0)
    {
        __aos_tty_load_history_slot();
        if(tty_payload >= 224) { raw_obj = tty_payload - 223; __aos_raw_invoke_obj(); } else { tty_line = tty_payload; if(tty_line != 0) { __aos_tty_render_line(); } }
        tty_slot = (tty_slot + 1) & 63;
        tty_remaining -= 1;
    }
    __aos_tty_draw_prompt();
}

resident function __aos_tty_redraw()
{
    console.clear();
    __aos_tty_redraw_now();
}

