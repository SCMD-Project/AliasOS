function __aos_raw_pin_history()
{
    if(raw_obj == 0 || raw_obj > RAW_OBJECT_COUNT) { return; }
    raw_used[raw_obj] = true;
    raw_hist[raw_obj] = true;
}

function __aos_raw_claim_file()
{
    if(raw_obj == 0 || raw_obj > RAW_OBJECT_COUNT) { return; }
    raw_used[raw_obj] = true;
    raw_file[raw_obj] = true;
}

function __aos_raw_release_file()
{
    if(raw_obj == 0 || raw_obj > RAW_OBJECT_COUNT) { return; }
    raw_file[raw_obj] = false;
    if(!raw_hist[raw_obj]) { raw_used[raw_obj] = false; }
}

function __aos_raw_release_pending_obj()
{
    if(raw_obj == 0 || raw_obj > RAW_OBJECT_COUNT) { return; }
    if(!raw_file[raw_obj] && !raw_hist[raw_obj]) { raw_used[raw_obj] = false; }
}

resident function __aos_raw_invoke_obj()
{
    if(raw_obj == 1) { command.exec("aos_str_1"); return; }
    if(raw_obj == 2) { command.exec("aos_str_2"); return; }
    if(raw_obj == 3) { command.exec("aos_str_3"); return; }
