export function __aos_fs_begin_raw_write()
{
    raw_ready = false; write_raw_obj = 255; __aos_raw_alloc();
}

export function __aos_fs_commit_raw_write()
{
    if(write_inode == 0 || write_inode >= INODE_COUNT) { return; }
    if(fs_raw[write_inode]) { raw_obj = fs_raw_obj[write_inode]; __aos_raw_release_file(); }
    fs_raw[write_inode] = true;
    fs_raw_obj[write_inode] = write_raw_obj;
    fs_size[write_inode] = 0;
    raw_obj = write_raw_obj;
    __aos_raw_claim_file();
    write_raw_obj = 255;
    tty_line = 84; __aos_tty_emit();
}

export function __aos_raw_release_pending()
{
    if(write_raw_obj != 255) { raw_obj = write_raw_obj; __aos_raw_release_pending_obj(); write_raw_obj = 255; }
}

export function __aos_fs_count_used()
{
    fs_used_count = 0;
    for(var i = 0; i < INODE_COUNT; i += 1)
    {
        if(fs_used[i]) { fs_used_count += 1; }
    }
}

export function __aos_fs_df()
{
    __aos_fs_count_used();
    if(fs_used_count == 0) { tty_line = 140; __aos_tty_emit(); return; }
