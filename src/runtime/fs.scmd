    if(write_inode == 14) { __aos_fs_commit_i14(); }
    if(write_inode == 15) { __aos_fs_commit_i15(); }
    tty_line = 84; __aos_tty_emit();
}

export function __aos_raw_alloc()
{
    write_raw_obj = 255;
    for(var i = 1; i <= RAW_OBJECT_COUNT; i += 1)
    {
        if(write_raw_obj == 255 && !raw_used[i]) { write_raw_obj = i; }
    }
    if(write_raw_obj == 1) { raw_used[1] = true; command.exec("alias aos_str_1 __aos_raw_missing"); return; }
    if(write_raw_obj == 2) { raw_used[2] = true; command.exec("alias aos_str_2 __aos_raw_missing"); return; }
