export function __aos_fs_commit_write()
{
    if(write_inode == 1) { __aos_fs_commit_i1(); }
    if(write_inode == 2) { __aos_fs_commit_i2(); }
    if(write_inode == 3) { __aos_fs_commit_i3(); }
    if(write_inode == 4) { __aos_fs_commit_i4(); }
